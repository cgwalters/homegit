{
  "name": "homegit",
  "image": "ghcr.io/bootc-dev/devenv-debian",
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer"
      ]
    },
    "devaipod": {
      "nestedContainers": true
    }
  },
  "features": {},
  "runArgs": [
    "--privileged"
  ],
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/usr/local/cargo/bin"
  }
}
