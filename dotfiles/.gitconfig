[user]
	email = walters@verbum.org
	name = Colin Walters
	githubid = cgwalters
	signingKey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIOQkQHeKan3X+g1jILw4a3KtcfEIED0kByKGWookU7ev walters+2015-general@verbum.org
[bz]
	browser = firefox3
[url "ssh://git@gitlab.gnome.org/GNOME/"]
	insteadof = gnome:
[url "https://github.com/"]
	insteadof = github-ro:
[url "ssh://git@github.com/"]
	insteadof = github:
[url "ssh://walters@git.freedesktop.org/git/"]
	insteadof = fd:
[url "ssh://git.fedorahosted.org/git/"]
	insteadof = fedorahosted:
[url "git+ssh://walters@git.launchpad.net/"]
        insteadof = lp:
[giggle]
	main-window-maximized = false
	main-window-geometry = 988x528+0+26
	history-view-vpane-position = 161
	file-view-vpane-position = 288
	file-view-hpane-position = 312
[url "git://git.debian.org/d-i/"]
	insteadOf = git+ssh://git.debian.org/git/d-i/
[format]
	pretty = fuller
[push]
	default = simple
[gpg]
	format = ssh
[alias]
	br = !git branch --sort=committerdate | tail -20
[alias]
	sw = !git switch
[alias]
	ck = !git checkout
[alias]
	rclean = !git clean -dfX && git submodule foreach git clean -dfX
[alias]
	rxclean = !git clean -dfx && git submodule foreach git clean -dfx
[alias]
	yolo = !git push --force-with-lease
[core]
	excludesfile = /home/walters/.gitignore
[diff]
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true
	renames = true
[safe]
	directory = /run/host/var/home/ai/src/aipproval-forge
	directory = /run/host/var/home/ai/
	directory = /run/host/var/home/ai/src/infra/
	directory = /run/host/var/home/ai/src/github/bootc-dev/infra
	directory = /run/host/var/home/ai/src/github/bootc-dev/ci-sandbox
	directory = /run/host/var/home/ai/src/github/bootc-dev/bootc
	directory = /run/host/var/home/ai/src/github/bootc-dev/bootc/.git
	directory = /run/host/var/home/ai/src/github/bootc-dev/bcvk/.git
	directory = /run/host/var/home/ai/src/github/ambient-code/platform
	directory = /run/host/var/home/ai/src/github/cgwalters/cstor-rs
	directory = /run/host/var/home/ai/src/github/cgwalters/devc
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gitlab.com"]
	helper = 
	helper = !/usr/bin/glab auth git-credential
[credential "https://gitlab.cee.redhat.com"]
	helper = 
	helper = !/usr/bin/glab auth git-credential
